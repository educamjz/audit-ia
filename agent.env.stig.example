# ─── Configuración del agente — PERFIL STIG (DISA) ───────────────────────
# Copia a  agent.env  y ajústalo. Cárgalo con:  set -a; . ./agent.env; set +a

# --- Objetivo a auditar (.50) ---
TARGET_HOST=192.168.10.50
TARGET_USER=ubuntu
TARGET_PASSWORD=
TARGET_SSH_KEY=/home/ubuntu/.ssh/id_ed25519
TARGET_SUDO_PASSWORD=

# --- OpenSCAP (STIG) ---
OSCAP_PROFILE_FAMILY=stig          # ← autodetecta el perfil STIG del datastream
OSCAP_DATASTREAM=                  # vacío = autodetección por versión de Ubuntu
OSCAP_PROFILE=                     # o fuerza uno exacto, p. ej:
                                   #   xccdf_org.ssgproject.content_profile_stig

# --- LLM (Ollama en .240) ---
LLM_BASE_URL=http://192.168.10.240:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# --- Límites de análisis ---
# STIG suele arrojar MUCHAS más reglas que CIS: sube el tope si quieres cobertura completa.
MAX_OSCAP_FINDINGS=60
OSCAP_BATCH=12
