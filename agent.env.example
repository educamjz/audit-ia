# ─── Configuración del agente de auditoría ───────────────────────────────
# Copia este fichero a  agent.env  y ajústalo. Cárgalo con:  set -a; . ./agent.env; set +a

# --- Objetivo a auditar (.50) ---
TARGET_HOST=192.168.10.50
TARGET_USER=ubuntu                 # usuario SSH en el objetivo
TARGET_PASSWORD=                   # deja vacío si usas clave SSH
TARGET_SSH_KEY=/home/ubuntu/.ssh/id_ed25519   # ruta a la clave privada (o vacío si usas password)
TARGET_SUDO_PASSWORD=              # password para 'sudo' en el objetivo (vacío si el usuario es root o tiene NOPASSWD)

# --- OpenSCAP ---
# Familia de perfil a autodetectar:  cis | stig | standard
OSCAP_PROFILE_FAMILY=cis
# Déjalos vacíos para autodetección (datastream según versión de Ubuntu y perfil de la familia elegida).
OSCAP_DATASTREAM=                  # ej: /usr/share/xml/scap/ssg/content/ssg-ubuntu2204-ds.xml
OSCAP_PROFILE=                     # fuerza un perfil exacto; ignora OSCAP_PROFILE_FAMILY si se define

# --- LLM (Ollama en .240) ---
LLM_BASE_URL=http://192.168.10.240:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama                 # Ollama ignora la clave, pero el cliente OpenAI la exige

# --- Límites de análisis (para no saturar el modelo 7B) ---
MAX_OSCAP_FINDINGS=40              # nº máximo de fallos OpenSCAP que se mandan al LLM (priorizados por severidad)
OSCAP_BATCH=12                     # tamaño de lote por llamada al LLM
